# API key for the LLM provider
LLM_API_KEY=
# Base URL of the OpenAI-compatible API endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model name to use for completions
LLM_MODEL=openai/gpt-oss-120b
# Optional: tokens per minute allowed by the provider, e.g. 8000 for the Groq free tier.
# When set, Maestro paces requests to stay under 90 percent of it. Empty means no pacing.
LLM_TPM_LIMIT=
